# Copy this file to  .env  in this same folder:
#
#     C:\PROJECTS\job auto fill\service\.env
#
# Read by podman.bat, podman-compose, and start.bat. No quotes around values --
# everything after the = is taken literally, spaces included.

# ---------------------------------------------------------------- required-ish
# Without a key the service still fills everything it can match from storage,
# but cannot route or draft answers.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Free models only. Set to 1.0 to allow cheap paid models as fallback rungs when
# the free tier's 20-requests-per-minute ceiling stalls a fill.
JOBKB_MAX_PRICE=0


# ------------------------------------------------------------------- resume
#
# IMPORTANT: the two ways of running the service need DIFFERENT paths here.
#
# --- Running directly (start.bat) -------------------------------------------
# Ordinary Windows paths. Uncomment these and delete the container block below.
#
# JOBKB_RESUME=C:\PROJECTS\Ditto\kb\resume\resume.txt
# JOBKB_RESUME_FILE=C:\Users\you\Documents\resume.pdf
#
# --- Running under Podman (podman.bat / compose) ----------------------------
# A container cannot see C:\ . Two steps:
#
#   1. JOBKB_RESUME_DIR is the folder on Windows that holds your resume. It is
#      mounted read-only into the container at /resume.
#   2. JOBKB_RESUME and JOBKB_RESUME_FILE are paths INSIDE the container, so
#      they start with /resume/ and use forward slashes.
#
# The filename is whatever it is on disk -- spaces are fine, no quotes.

JOBKB_RESUME_DIR=C:\Users\you\Documents
JOBKB_RESUME=/resume/resume.txt
JOBKB_RESUME_FILE=/resume/resume.pdf

# Both files must be in that one folder for this to work. If your .txt and .pdf
# live apart, either move one, or skip all of this and use the file picker in
# the extension's Options -- it uploads through the browser, so no mount and no
# path translation is involved.
#
# These are re-read at every start and only rewritten when the file has actually
# changed, so a resume you keep editing stays in step by itself.


# ------------------------------------------------------------------- optional
# JOBKB_PORT=8765
# JOBKB_TOKEN=                 a shared secret the extension must also send
# JOBKB_MODEL=                 pin one model instead of discovering free ones
# JOBKB_TIMEOUT=90             seconds per model call
